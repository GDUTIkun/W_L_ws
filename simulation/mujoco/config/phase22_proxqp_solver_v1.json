    "max_iter": 10000,
    "max_iter_in": 1500,
    "safe_guard": 10000,
    "iterative_refinement_count": 10,
    "eps_refact": 1e-6,
    "verbose": false,
    "compute_preconditioner_on_init": true,
    "update_preconditioner": false,
    "compute_timings": false,
    "check_duality_gap": false,
    "eps_duality_gap_abs": 1e-4,
    "eps_duality_gap_rel": 0,
    "preconditioner_max_iter": 10,
    "preconditioner_accuracy": 1e-3,
    "eps_primal_infeasibility": 1e-4,
    "eps_dual_infeasibility": 1e-4,
    "bcl_update": true,
    "merit_function": "GPDAL",
