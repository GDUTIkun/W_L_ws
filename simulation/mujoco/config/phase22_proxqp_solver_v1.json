{
  "schema_version": 1,
  "phase": 22,
  "profile": "phase22-proxqp-solver-v1",
  "solver": {
    "package": "ProxSuite",
    "version": "0.7.3",
    "source_commit": "b93d7778ffc3299d84b5cb0851022a29bf24a596",
    "api": "proxsuite::proxqp::dense::QP<double>",
    "backend": "PrimalDualLDLT",
    "variables": 42,
    "maximum_bound_form_rows": 128,
    "authoritative_wbc_equality_rows": 12,
    "authoritative_wbc_inequality_rows": 92,
    "eps_abs": 1e-8,
